            if (window.GLY_USE_FENGARI || window.GLY_BUILD_FENGARI) {
              glyBootLog('Fengari loop via runtime tick');
            }
            if (window.IS_TV) installTvKeys(gly.frontend);
            if (window.IS_TV && gly.frontend && gly.frontend.native_callback_resize) {
              function glyTvFit() {
                var w = window.innerWidth || (screen && screen.width) || 1920;
                var h = window.innerHeight || (screen && screen.height) || 1080;
                glyBootLog('TV resize ' + w + 'x' + h);
                gly.frontend.native_callback_resize(w, h);
              }
              glyTvFit();
              window.addEventListener('resize', glyTvFit);
              setTimeout(glyTvFit, 250);
              setTimeout(glyTvFit, 1500);
            }
          })
          .catch(function (e) {
            glyBootLog('BUILD FAIL: ' + (e && e.message ? e.message : e));
            if (e && e.stack && window.GLY_BOOT_ON) glyBootLog(String(e.stack).split('\n').slice(0, 2).join(' | '));
          });
      });
