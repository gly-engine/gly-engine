          .then(function (gly) {
            window.gly = gly;
            glyBootLog('gly ok' + (window.GLY_USE_FENGARI ? ' [FENGARI]' : ''));
            if (window.GLY_USE_FENGARI || window.GLY_FORCE_FENGARI) {
              var ec = gamelyInline('engine_code');
              glyBootLog('game inline len=' + gamelyInline('game_code').length);
              glyBootLog('engine pending_game_boot=' + (ec.indexOf('pending_game_boot') >= 0));
              glyBootLog('engine http gly log=' + (ec.indexOf('[gly] http run') >= 0));
