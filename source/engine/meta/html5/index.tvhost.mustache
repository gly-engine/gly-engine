            }
          });
          return window.__glyCoreNativeHtml5Promise;
        };
      })();
    </script>
    <script>
      function gamelyInline(key) {
        var s = window[key];
        if (typeof s === 'string' && s.length > 0) {
          var cut = s.indexOf('\0');
          if (cut !== -1) s = s.slice(0, cut);
          return s;
        }
        throw new Error('missing inline code: ' + key);
      }

      function patchFengariGameLua(src) {
        if (!(window.GLY_USE_FENGARI || window.GLY_FORCE_FENGARI || window.GLY_BUILD_FENGARI)) return src;
        if (src.indexOf('end /* __glyFengariAsyncPump */') !== -1) {
          src = src.replace(/end \/\* __glyFengariAsyncPump \*\//g, 'end -- __glyFengariAsyncPump');
          glyBootLog('game patch AsyncAwaiter comment fix');
        }
        if (src.indexOf('__glyFengariAsyncPump') >= 0 && src.indexOf('__glyPromisePump') >= 0) return src;
        var needle = 'function fulfilled(self, value)\nlocal success, resultOrError = coresume(asyncCoroutine, value)';
        if (src.indexOf(needle) !== -1) {
          glyBootLog('game patch AsyncAwaiter→pump');
          src = src.replace(
            needle,
            needle + '\nif type(_G.__gly_schedule_pump) == "function" then pcall(_G.__gly_schedule_pump) end -- __glyFengariAsyncPump'
          );
        }
        if (src.indexOf('__glyPromisePump') === -1 && src.indexOf('function __TS__Promise.prototype.invokeCallbacks') !== -1) {
          src = src.replace(
            'return callbacks[callbacksLength](callbacks, value)',
            'local __glyPromiseRet = callbacks[callbacksLength](callbacks, value)\nif type(_G.__gly_schedule_pump) == "function" then pcall(_G.__gly_schedule_pump) end\nreturn __glyPromiseRet -- __glyPromisePump'
          );
          glyBootLog('game patch Promise invokeCallbacks→pump');
        }
        return src;
      }

      var TV_KEYS = [
        [13, 'a'], [37, 'left'], [38, 'up'], [39, 'right'], [40, 'down'],
        [403, 'a'], [404, 'b'], [405, 'c'], [406, 'd'], [10009, 'menu'], [461, 'menu'],
        ['Enter', 'a'], ['ArrowLeft', 'left'], ['ArrowRight', 'right'], ['ArrowUp', 'up'], ['ArrowDown', 'down'],
        ['Left', 'left'], ['Right', 'right'], ['Up', 'up'], ['Down', 'down'], ['Back', 'menu']
      ];
      if (window.KeyEvent && KeyEvent.VK_BACK != null) TV_KEYS.push([KeyEvent.VK_BACK, 'menu']);

      function gamelyKey(e) {
        for (var i = 0; i < TV_KEYS.length; i++) {
          var k = TV_KEYS[i][0];
          if (k === e.key || k === e.code || k === e.keyCode) return TV_KEYS[i][1];
        }
        return null;
      }

      function installTvKeys(frontend) {
        var send = frontend.native_callback_keyboard;
        function onKey(ev) {
          var g = gamelyKey(ev);
          if (!g) return;
          ev.preventDefault();
          if (g === 'menu' && ev.type === 'keydown') {
            send('menu', 1);
            send('menu', 0);
            return;
          }
          send(g, ev.type === 'keydown' ? 1 : 0);
        }
        window.addEventListener('keydown', onKey, true);
        window.addEventListener('keyup', onKey, true);
        glyBootLog('TV keys installed');
      }

      function ensureRuntime() {
        if (window.LuaFactory || window.fengari) return Promise.resolve();
        glyBootLog('waiting runtime (wasmoon/fengari)…');
        return new Promise(function (resolve, reject) {
          var done = false;
          function finish(ok, msg) {
            if (done) return;
            done = true;
            if (msg) glyBootLog(msg);
            if (ok) resolve();
            else reject(new Error(msg || 'runtime failed'));
          }
          function ready() {
            var ok = !!(window.LuaFactory || window.fengari);
            finish(ok, ok ? (window.LuaFactory ? 'wasmoon ready' : 'fengari ready') : 'runtime missing');
          }
          window.addEventListener('gly-wasmoon-ready', ready);
          setTimeout(ready, 45000);
        });
      }

      function ensureBundle() {
        if (window.engine_code && window.game_code) return Promise.resolve();
        glyBootLog('waiting index.js (engine_code)…');
        return new Promise(function (resolve, reject) {
          var n = 0;
          var id = setInterval(function () {
            n++;
            if (window.engine_code && window.game_code) {
              clearInterval(id);
              glyBootLog('bundle ok len=' + window.engine_code.length);
              resolve();
            } else if (n > 900) {
              clearInterval(id);
              reject(new Error('index.js / engine_code timeout'));
            }
          }, 50);
        });
      }

      document.addEventListener('DOMContentLoaded', function () {
        glyBootLog('DOMContentLoaded');
        Promise.all([ensureRuntime(), ensureBundle(), ensureCoreNativeHtml5()])
          .then(function () {
            if (typeof CoreNativeHtml5 !== 'function') throw new Error('CoreNativeHtml5 missing');
            glyBootLog('CoreNativeHtml5 build…');
            var chain = CoreNativeHtml5()
              .setElementRoot('main')
              .setElementCanvas('#gameCanvas')
              .addLibrary('wasmoon', window.LuaFactory, window.LuaMultiReturn)
              .addLibrary('fengari', window.fengari)
              .addLibrary('fengari-or-wasmoon-check')
              .addLibrary('runtime', {
                unfocus_pause: !(window.GLY_USE_FENGARI || window.GLY_FORCE_FENGARI)
