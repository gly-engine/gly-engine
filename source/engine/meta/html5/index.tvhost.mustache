<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{ meta.title }} - {{ meta.version }}</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <meta name="theme-color" content="#000000"/>
    <meta name="description" content="{{ meta.description }}"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
{{# assets.fonts }}
    <link rel="preload" href="{{& fn.colon.to }}" as="font" type="font/ttf" crossorigin/>
{{/ assets.fonts }}
    <style>
        *, *::after, *::before {
            touch-action: none;
            box-sizing: border-box;
            border: 0;
            padding: 0;
            margin: 0;
        }
        body {
            height: 99.998vh;
            display: flex;
            overflow: hidden;
            justify-content: center;
            align-items: start;
        }
        main { position: relative; width: 100%; height: 100%; }
        video { position: absolute; }
        canvas { position: absolute; }
    </style>
    {{^ args.aa }}
    <style>canvas { image-rendering: pixelated; }</style>
    {{/}}
    {{# var.build.screen.has_flag }}
    <style>#gameCanvas { width: 100%; }</style>
    {{/ var.build.screen.has_flag }}
    <style>body { background-color: gray; }</style>
    {{# assets.fonts }}
    <style>
      @font-face {
        font-family: "{{ fn.colon.from }}";
        src: url("{{& fn.colon.to }}");
      }
    </style>
    {{/ assets.fonts }}
    <style>
      #gly-boot-log {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 99999;
        max-height: 42vh; overflow: auto; padding: 6px 8px;
        font: 12px/1.35 monospace; color: #0f0; background: rgba(0,0,0,.88);
        white-space: pre-wrap; pointer-events: none;
      }
    </style>
  </head>
  <body>
    <div id="gly-boot-log" aria-live="polite"></div>
    <main>
      <canvas id="gameCanvas" {{& var.build.screen.wh_attributes }}></canvas>
    </main>
    {{# var.build.html5.atobify }}
    <script src="index.js" defer></script>
    {{/ var.build.html5.atobify }}
    <script>
      (function () {
        var IS_TV = location.protocol === 'file:' || /Smart-TV|Tizen|Web0S|webOS|LG/i.test(navigator.userAgent);
        var FORCE_FENGARI = location.search.indexOf('runtime=fengari') >= 0;
        var FORCE_WASMOON = location.search.indexOf('runtime=wasmoon') >= 0;
{{# args.fengari }}
        var GLY_BUILD_FENGARI = true;
{{/ args.fengari }}
{{^ args.fengari }}
        var GLY_BUILD_FENGARI = false;
{{/ args.fengari }}
        window.GLY_FORCE_FENGARI = FORCE_FENGARI;
        window.GLY_FORCE_WASMOON = FORCE_WASMOON;
        window.GLY_BUILD_FENGARI = GLY_BUILD_FENGARI;
        var bootOn = IS_TV || FORCE_FENGARI || GLY_BUILD_FENGARI || location.search.indexOf('debug=1') >= 0 || location.hash.indexOf('debug=1') >= 0;
        window.GLY_BOOT_ON = bootOn;
        var logEl = document.getElementById('gly-boot-log');
        var lines = [];
        window.glyBootLog = function (msg) {
          if (!bootOn) return;
          var t = new Date().toISOString().slice(11, 23);
          lines.push(t + ' ' + msg);
          var maxLines = IS_TV ? 120 : 22;
          if (lines.length > maxLines) lines.shift();
          logEl.textContent = lines.join('\n');
          try {
            logEl.scrollTop = logEl.scrollHeight;
          } catch (e) {}
          try { console.log('[gly-boot]', msg); } catch (e) {}
        };
        window.IS_TV = IS_TV;
        if (IS_TV) {
          var tvFit = document.createElement('style');
          tvFit.textContent =
            'html, body, main { width: 100%; height: 100%; overflow: hidden; }' +
            '#gameCanvas { width: 100% !important; height: 100% !important; left: 0 !important; top: 0 !important; }';
          document.head.appendChild(tvFit);
        }
        if (bootOn) {
          glyBootLog('boot ua=' + navigator.userAgent.slice(0, 96));
          glyBootLog('protocol=' + location.protocol);
          if (location.protocol === 'file:') {
            glyBootLog('TV file:// — se xhr falhar, sirva dist/ via http:// (LAN)');
          }
          window.addEventListener('error', function (e) { glyBootLog('ERROR: ' + (e.message || e)); });
          window.addEventListener('unhandledrejection', function (e) {
            glyBootLog('PROMISE: ' + (e.reason && e.reason.message ? e.reason.message : e.reason));
          });
        }
        window.scheduleLuaPump = function () {
          setTimeout(function () {
            try {
              if (window.gly && window.gly.frontend && window.gly.frontend.native_callback_loop) {
                window.gly.frontend.native_callback_loop(16);
                if (window.gly.frontend.native_callback_draw) {
                  window.gly.frontend.native_callback_draw();
                }
              }
            } catch (e) {}
          }, 0);
        };
        window.scheduleFengariPump = window.scheduleLuaPump;
        function glyTvFileOrigin() {
          return location.protocol === 'file:' && window.IS_TV;
        }
        window.glyFetchViaXhr = glyFetchViaXhr;
        function glyFetchViaXhr(url, init) {
          init = init || {};
          var method = ((init.method || 'GET') + '').toUpperCase();
          return new Promise(function (resolve, reject) {
            var xhr = new XMLHttpRequest();
            try { xhr.timeout = 90000; xhr.withCredentials = false; } catch (e) {}
            xhr.open(method, url, true);
            if (init.headers) {
              var h = init.headers;
              if (typeof h.forEach === 'function') {
                h.forEach(function (v, k) { try { xhr.setRequestHeader(k, v); } catch (e) {} });
              } else {
                for (var hk in h) {
                  if (Object.prototype.hasOwnProperty.call(h, hk)) {
                    try { xhr.setRequestHeader(hk, h[hk]); } catch (e) {}
                  }
                }
              }
            }
            xhr.responseType = 'arraybuffer';
            xhr.onload = function () {
              if (xhr.status === 0 || (xhr.status >= 200 && xhr.status < 300)) {
                var ct = xhr.getResponseHeader('Content-Type') || 'application/octet-stream';
                resolve(new Response(xhr.response, {
                  status: xhr.status || 200,
                  statusText: xhr.statusText || 'OK',
                  headers: { 'Content-Type': ct }
                }));
              } else {
                reject(new TypeError('Failed to fetch'));
              }
            };
            xhr.onerror = function () { reject(new TypeError('Failed to fetch')); };
            try {
              xhr.send(init.body != null ? init.body : null);
            } catch (e) {
              reject(e);
            }
          });
        }
        function glyWrapLuaPump(p) {
          return p.then(function (res) {
            window.scheduleLuaPump();
            return res;
          }, function (err) {
            window.scheduleLuaPump();
            throw err;
          });
        }
        var origFetch = window.fetch;
        window.fetch = function (input, init) {
          var url = (typeof input === 'string') ? input : (input && input.url) || String(input);
          var a = document.createElement('a');
          a.href = url;
          if (a.protocol === 'file:') {
            if (bootOn) glyBootLog('fetch file:// blocked (engine/game=index.js; assets≠fetch)');
            return Promise.reject(new TypeError('fetch file:// not supported'));
          }
          if (bootOn && url.indexOf('cloud.zedia.tv') !== -1) glyBootLog('fetch ' + url.split('?')[0].slice(-48));
          if (glyTvFileOrigin()) {
            if (bootOn && (url.indexOf('.wasm') !== -1 || url.indexOf('cloud.zedia.tv') !== -1)) {
              glyBootLog('fetch xhr ' + url.split('/').pop().slice(0, 40));
            }
            return glyWrapLuaPump(glyFetchViaXhr(a.href, init));
          }
          return glyWrapLuaPump(origFetch.call(window, input, init));
        };
      })();
    </script>
    <script>
      (function () {
        function signalReady() {
          try { window.dispatchEvent(new Event('gly-wasmoon-ready')); } catch (e) {
            var ev = document.createEvent('Event');
            ev.initEvent('gly-wasmoon-ready', true, true);
            window.dispatchEvent(ev);
          }
        }
        function bindWasmoon() {
          var g = window.wasmoon;
          if (g && g.LuaFactory) {
            window.LuaFactory = g.LuaFactory;
            window.LuaMultiReturn = g.LuaMultiReturn;
            return true;
          }
          return false;
        }
        function loadScript(src, onDone) {
          var s = document.createElement('script');
          s.src = src;
          s.onload = function () { onDone(null); };
          s.onerror = function () { onDone(new Error('load ' + src)); };
          document.head.appendChild(s);
        }
        function loadScriptTry(urls, i, onDone) {
          if (i >= urls.length) {
            onDone(new Error('script load failed'));
            return;
          }
          glyBootLog('script ' + urls[i].split('/').pop());
          var s = document.createElement('script');
          s.src = urls[i];
          s.onload = function () { onDone(null); };
          s.onerror = function () { loadScriptTry(urls, i + 1, onDone); };
          document.head.appendChild(s);
        }
        function loadFengari(onDone) {
          glyBootLog('Fengari — teste PC: ?runtime=fengari&debug=1');
          window.GLY_USE_FENGARI = true;
          window.LuaFactory = undefined;
          window.LuaMultiReturn = undefined;
          var urls = window.IS_TV || location.protocol === 'file:'
            ? ['fengari-web.js', 'https://cdn.jsdelivr.net/npm/fengari-web@0.1.4/dist/fengari-web.js']
            : ['https://cdn.jsdelivr.net/npm/fengari-web@0.1.4/dist/fengari-web.js'];
          loadScriptTry(urls, 0, function (err) {
            glyBootLog(err ? 'Fengari FAIL' : 'Fengari ok');
            onDone();
          });
        }
        function loadWasmoonUmd(ver, onDone) {
          glyBootLog('wasmoon UMD ' + ver + '…');
          loadScript('https://cdn.jsdelivr.net/npm/wasmoon@' + ver + '/dist/index.js', function (err) {
            if (err || !bindWasmoon()) onDone(err || new Error('LuaFactory missing'));
            else {
              glyBootLog('wasmoon ' + ver + ' ok');
              onDone(null);
            }
          });
        }
        function loadFengariThenWasmoonFallback() {
          loadFengari(function () {
            if (window.fengari) return signalReady();
            glyBootLog('Fengari missing — wasmoon fallback');
            loadWasmoonUmd('1.10.0', function (err) {
              if (!err) return signalReady();
              loadWasmoonUmd('1.12.0', function () { signalReady(); });
            });
          });
        }
        if (window.GLY_FORCE_FENGARI || window.GLY_BUILD_FENGARI) {
          loadFengari(signalReady);
        } else if (window.GLY_FORCE_WASMOON) {
          loadWasmoonUmd('1.16.0', function (err) {
            if (err) glyBootLog('wasmoon 1.16 fail');
            signalReady();
          });
        } else if (window.IS_TV) {
          loadFengariThenWasmoonFallback();
        } else {
          var m = document.createElement('script');
          m.type = 'module';
          m.textContent =
            "import { LuaFactory, LuaMultiReturn } from 'https://cdn.jsdelivr.net/npm/wasmoon@1.16.0/+esm';" +
            "window.LuaFactory=LuaFactory;window.LuaMultiReturn=LuaMultiReturn;" +
            "glyBootLog('wasmoon ESM ok');window.dispatchEvent(new Event('gly-wasmoon-ready'));";
          document.head.appendChild(m);
        }
      })();
    </script>
